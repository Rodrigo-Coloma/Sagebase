# --- NCBI / PubMed -----------------------------------------------------------
# Strongly recommended: NCBI raises rate limit from 3 req/s -> 10 req/s with key.
# https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=
NCBI_TOOL=medlit
NCBI_EMAIL=you@example.com

# --- Generation --------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VOYAGE_API_KEY=

# --- Open access full-text ---------------------------------------------------
# https://unpaywall.org/products/api  (free; requires email)
UNPAYWALL_EMAIL=you@example.com

# --- Vector store ------------------------------------------------------------
MEDLIT_VECTOR_BACKEND=qdrant       # qdrant | chroma | pgvector
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=medlit

# --- Embeddings --------------------------------------------------------------
MEDLIT_EMBEDDING_BACKEND=sentence_transformers  # sentence_transformers | openai | voyage
MEDLIT_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
# alternates: pritamdeka/S-PubMedBert-MS-MARCO  (biomedical)
#             text-embedding-3-large            (OpenAI)
#             voyage-3                          (Voyage)

# --- Reranker ----------------------------------------------------------------
MEDLIT_RERANKER_MODEL=BAAI/bge-reranker-large

# --- Generator ---------------------------------------------------------------
MEDLIT_GENERATION_BACKEND=anthropic   # anthropic | openai | ollama
MEDLIT_GENERATION_MODEL=claude-sonnet-4-5

# --- Storage paths -----------------------------------------------------------
MEDLIT_DATA_DIR=./data
MEDLIT_CACHE_DIR=./data/cache

# --- API ---------------------------------------------------------------------
MEDLIT_API_HOST=0.0.0.0
MEDLIT_API_PORT=8000
MEDLIT_LOG_LEVEL=INFO
