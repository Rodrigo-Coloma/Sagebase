# Copy to `.streamlit/secrets.toml` for local dev, or paste these keys into
# the Streamlit Community Cloud "Secrets" UI when deploying.
#
# At minimum you need OPENAI_API_KEY (for embeddings) and ANTHROPIC_API_KEY
# (for /ask). Everything else is optional.

OPENAI_API_KEY = "sk-..."
ANTHROPIC_API_KEY = "sk-ant-..."

# NCBI strongly recommends a tool name + email; an API key raises your PubMed
# rate limit from 3 -> 10 req/s. https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_EMAIL = "you@example.com"
NCBI_API_KEY = ""

# Unpaywall: needs a contact email (free, no signup). Used to find legitimate
# open-access full-text PDFs. https://unpaywall.org/products/api
UNPAYWALL_EMAIL = "you@example.com"

# Optional: point at a Qdrant Cloud cluster instead of local Chroma to get
# durable storage across app reboots. https://cloud.qdrant.io
# QDRANT_URL = "https://YOUR-CLUSTER.qdrant.io"
# QDRANT_API_KEY = ""
