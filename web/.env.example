# Override only when the API is not at the same origin behind /api.
# In a docker-compose deploy this is unset and nginx proxies /api -> api:8000.
# For local dev with `npm run dev`, vite already proxies /api -> :8000.
# For a separate-host deploy, e.g. when serving the SPA from a CDN:
# VITE_API_BASE=https://api.example.com
VITE_API_BASE=/api
